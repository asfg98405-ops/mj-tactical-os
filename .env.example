# ==============================================================================
# MJ TACTICAL OS: ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Security Policy: Zero-Trust Enforced. Never commit .env or secrets to Git.

# Gateway Server Configuration
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=4848

# Authentication (Zero-Trust Bearer Token)
# If left empty, a cryptographic 32-byte hex token is generated dynamically on boot.
GATEWAY_AUTH_KEY=

# Tactical Node Identity
NODE_ID=MJ-TACTICAL-ALPHA-01
OPERATOR_HANDLE=MJ-OPERATOR
DEVICE_PROFILE=REDMAGIC-TACTICAL-FIELD

# Telemetry & Sampling Interval (seconds: 1-60)
TELEMETRY_INTERVAL_SEC=5
SCAN_MODE=PASSIVE_AUDIT

# Network Audit Options
AUDIT_TIMEOUT_MS=30000
WOL_BROADCAST=255.255.255.255
WOL_PORT=9
